{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2023",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node", "bun"]
  },
  "include": ["plugins/omp-magpie/src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
}
